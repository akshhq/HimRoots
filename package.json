{
  "name": "himroots-wellness",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node dist-server/index.js",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "esbuild server/index.ts --platform=node --format=esm --bundle --packages=external --outfile=dist-server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "build:client": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --platform=node --format=esm --bundle --packages=external --outfile=dist-server/index.js",
    "build": "npm run build:client && npm run build:server",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/supabase-js": "^2.117.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "framer-motion": "^13.4.1",
    "lucide-react": "^1.47.0",
    "razorpay": "^2.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
