# =============================================================================
# HIMROOTS WELLNESS — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this template to create your environment files:
#   Local Development:   cp .env.example .env
#   Production Deploy:   Set these key-value pairs on your hosting platform dashboard
#
# CRITICAL SECURITY RULES:
# 1. Variables prefixed with VITE_ are compiled directly into public browser bundles.
#    NEVER put secret keys, database passwords, or private API tokens in VITE_ variables!
# 2. Variables WITHOUT VITE_ are strictly read server-side by Node.js/Express.
#    They must NEVER be exposed to or referenced by client-side code.
# =============================================================================

# =============================================================================
# 1. PUBLIC / FRONTEND CONFIGURATION (Exposed to browser via Vite)
# =============================================================================

# Supabase Project URL (Found in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Safe for client browsers; restricted by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Backend API Base URL
# - Local dev: Leave blank or set to http://localhost:5000 (uses Vite dev proxy '/api')
# - Production: Set to your public API origin, e.g., https://api.himroots.in (or leave blank if using Apache reverse proxy on same domain)
VITE_API_BASE_URL=

# Razorpay Key ID for client checkout modal (Test: rzp_test_..., Live: rzp_live_...)
# ONLY the public Key ID is exposed to frontend. Key Secret must NEVER be placed here.
VITE_RAZORPAY_KEY_ID=rzp_test_yourkeyidhere

# =============================================================================
# 2. SERVER-ONLY SECRETS (NEVER exposed to frontend / browser)
# =============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=production

# Permitted CORS Origins (comma-separated list for production)
# Example: https://himroots.in,https://www.himroots.in
CORS_ORIGIN=https://himroots.in,https://www.himroots.in

# Supabase Server-Side Configuration
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (Bypasses Row Level Security for backend orders)
# WARNING: Keep confidential. Never leak or commit to source control.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Razorpay Gateway Secrets (Found in Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_yourkeyidhere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional: Razorpay Webhook Secret (Found in Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# =============================================================================
# 3. TRANSACTIONAL EMAIL SECRETS (Resend or Brevo)
# =============================================================================

# Provider selection: 'resend' or 'brevo' (Default: resend)
EMAIL_PROVIDER=resend

# Transactional Email Provider API Key (Resend: re_... or Brevo: xkeysib-...)
# WARNING: Keep confidential. Never leak or commit to source control.
EMAIL_API_KEY=re_your_transactional_email_api_key_here
RESEND_API_KEY=re_your_transactional_email_api_key_here

# Verified Sender Address (Requires domain DNS verification on provider dashboard)
EMAIL_FROM=Himroots Wellness <orders@himroots.in>
SENDER_EMAIL=Himroots Wellness <orders@himroots.in>

# Client Order Fulfillment Inbox (Receives immediate notifications on new paid orders)
CLIENT_ORDER_EMAIL=orders@himroots.in
CLIENT_NOTIFICATION_EMAIL=orders@himroots.in

# Client Customer Support Inbox (Receives incoming customer contact form inquiries)
CLIENT_SUPPORT_EMAIL=support@himroots.in
