# =============================================================================
# HIMROOTS WELLNESS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - Never commit real secrets or production credentials to source control.
# - Variables prefixed with VITE_ are bundled into client-side JavaScript.
# - Variables WITHOUT VITE_ are strictly reserved for serverless/backend code.
# =============================================================================

# Server Port (Default: 5000)
PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed to browser)
# -----------------------------------------------------------------------------

# Supabase Project URL (Found in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Safe for client browsers)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Backend API Base URL (leave empty in local dev to use Vite proxy /api, or specify full URL for production deployments)
VITE_API_BASE_URL=http://localhost:5000

# Razorpay Key ID for client checkout modal (Test: rzp_test_..., Live: rzp_live_...)
# ONLY the public Key ID is exposed to frontend. Secret is NEVER placed here.
VITE_RAZORPAY_KEY_ID=rzp_test_yourkeyidhere

# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY ENVIRONMENT VARIABLES (NEVER exposed to frontend)
# -----------------------------------------------------------------------------

# Supabase Project URL (Same as VITE_SUPABASE_URL or custom internal URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (Bypasses Row Level Security for backend orders)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Razorpay Key ID & Key Secret (Found in Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_yourkeyidhere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# -----------------------------------------------------------------------------
# TRANSACTIONAL EMAIL CONFIGURATION (Resend or Brevo)
# -----------------------------------------------------------------------------

# Provider selection: 'resend' or 'brevo' (Default: resend)
EMAIL_PROVIDER=resend

# Transactional Email Provider API Key (Resend: re_... or Brevo: xkeysib-...)
EMAIL_API_KEY=re_your_transactional_email_api_key_here
RESEND_API_KEY=re_your_transactional_email_api_key_here

# Verified Sender Address (Requires domain DNS verification on provider dashboard)
EMAIL_FROM=Himroots Wellness <orders@himroots.com>
SENDER_EMAIL=Himroots Wellness <orders@himroots.com>

# Client Order Fulfillment Inbox (Receives immediate notifications on new paid orders)
CLIENT_ORDER_EMAIL=orders@himroots.com
CLIENT_NOTIFICATION_EMAIL=orders@himroots.com

# Client Customer Support Inbox (Receives incoming customer contact form inquiries)
CLIENT_SUPPORT_EMAIL=support@himroots.com
