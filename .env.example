# Himroots JavaScript server configuration

# Local server port and environment
PORT=5000
NODE_ENV=development

# Comma-separated browser origins permitted to call the API in production.
CORS_ORIGIN=http://localhost:5000,https://himroots.in,https://www.himroots.in

# Razorpay credentials (test or live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Transactional Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
CLIENT_ORDER_EMAIL=orders@himroots.in
CLIENT_SUPPORT_EMAIL=support@himroots.in
EMAIL_FROM=Himroots Wellness <orders@himroots.in>

# Supabase Database (optional sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
