# =============================================================================
# HIMROOTS WELLNESS — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this template to create your local development environment:
#   cp .env.example .env
#
# ARCHITECTURAL SEPARATION & SECURITY RULES:
# 1. FRONTEND / VITE VARIABLES (Prefixed with VITE_):
#    - Exposed directly to customer browser bundles.
#    - Used by React SPA in src/lib/api.ts, src/lib/supabase.ts, src/pages/Checkout.tsx.
#    - NEVER put database passwords, service-role keys, or private API secrets in VITE_ variables!
#    - For production builds, configure these in your CI/CD or .env.production (gitignored).
#
# 2. BACKEND / NODE.JS VARIABLES (Without VITE_ prefix):
#    - Strictly server-side only (server/config/env.ts).
#    - Never imported or bundled by frontend code.
#    - Configure these on your backend hosting platform (e.g., Render, Railway, VPS).
# =============================================================================

# =============================================================================
# 1. FRONTEND CONFIGURATION (Vite / Browser Bundle)
# =============================================================================

# Backend API Base URL
# - Local development: Leave empty (Vite dev server proxies /api/* requests to localhost:5000)
# - Production build: Set to public API URL (e.g., https://api.himroots.in or https://himroots-api.onrender.com)
VITE_API_BASE_URL=

# Supabase Project URL (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (Protected by Row Level Security; safe for client browsers)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Razorpay Key ID for client checkout popup (Test: rzp_test_..., Live: rzp_live_...)
# ONLY the public Key ID is exposed to frontend. Key Secret must NEVER be placed here.
VITE_RAZORPAY_KEY_ID=rzp_test_yourkeyidhere

# =============================================================================
# 2. BACKEND CONFIGURATION (Node.js / Express Server-Only)
# =============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Allowed CORS Origins (comma-separated list)
# Production: https://himroots.in,https://www.himroots.in
# Local dev: http://localhost:5173,http://localhost:5174
CORS_ORIGIN=https://himroots.in,https://www.himroots.in

# Supabase Server Connection (Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (Bypasses Row Level Security for order writing and administrative tasks)
# WARNING: Keep confidential. Never leak or commit to version control.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Razorpay Gateway Credentials (Dashboard > Account & Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_yourkeyidhere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Dashboard > Account & Settings > Webhooks)
# Used to verify HMAC signature on POST /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Transactional Email Provider: 'resend' or 'brevo' (Default: resend)
EMAIL_PROVIDER=resend

# Transactional Email Provider API Key (Resend: re_... or Brevo: xkeysib-...)
# WARNING: Keep confidential. Never leak or commit to version control.
EMAIL_API_KEY=re_your_transactional_email_api_key_here

# Verified Sender Address (Requires domain DNS verification on provider dashboard)
EMAIL_FROM=Himroots Wellness <orders@himroots.in>

# Warehouse / Order Fulfillment Inbox (Receives immediate notification with shipping details on new orders)
CLIENT_ORDER_EMAIL=orders@himroots.in

# Customer Support Inbox (Receives incoming inquiries from the website contact form)
CLIENT_SUPPORT_EMAIL=support@himroots.in
