# ==============================================================================
# Himroots Wellness — Production Apache Configuration for Single Page App (SPA)
# ==============================================================================
# Enables HTML5 pushState (BrowserRouter) routing in /public_html/.
# Rewrites all virtual client routes (e.g., /cart, /shop, /products/*, /about,
# /contact, /checkout, /order-success, /sea-buckthorn) internally to /index.html
# without altering the browser URL.
# Real static files (assets, images, scripts) are served directly.
# API requests (/api/*) are preserved and never rewritten to index.html.
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Prevent Apache MultiViews from interfering with route names
  Options -MultiViews

  # If index.html is requested directly, don't rewrite
  RewriteRule ^index\.html$ - [L]

  # Do NOT rewrite API routes to index.html (preserves backend endpoints & reverse proxy)
  RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
  RewriteRule ^ - [L]

  # If the requested path is an existing physical file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, rewrite all application routes internally to index.html (URL in browser remains unchanged)
  RewriteRule ^ index.html [L]
</IfModule>

# Caching & performance policies
<IfModule mod_headers.c>
  # Ensure index.html is not stale-cached so updates apply immediately
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache hashed static assets (JS, CSS, images) efficiently
  <FilesMatch "\.(js|css|webp|jpg|jpeg|png|svg|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
